background-opacity = .35

font-size = 14
window-decoration = false
#cursor-style = underline
mouse-hide-while-typing = true
window-save-state = always
adjust-cell-height = 10%
#maximize = true

# Announce ourselves as xterm-256color instead of xterm-ghostty. Every ncurses
# install already carries that entry, so curses apps (nano, htop) work on any
# remote host without installing terminfo there first. The cost is Ghostty's own
# terminfo extras, notably the xterm prefix that makes vim turn on
# modifyOtherKeys, so some Ctrl+Shift combinations stop being distinguishable.
term = xterm-256color

# Kept as a second layer, and the safety net if `term` above is ever reverted:
# ssh-terminfo installs Ghostty's terminfo on remotes via infocmp/tic and caches
# which hosts are done (ghostty +ssh-cache), ssh-env propagates COLORTERM and
# friends. Both are off in Ghostty's defaults; the other values here are the
# defaults, repeated because this setting replaces the whole list.
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

### keybinds ###
keybind = ctrl+alt+a=new_tab
keybind = ctrl+alt+z=close_tab:this
keybind = ctrl+shift+s=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+shift+q=close_surface
keybind = ctrl+shift+arrow_right=goto_split:next
keybind = ctrl+shift+arrow_left=goto_split:previous
keybind = ctrl+shift+r=reset
keybind = ctrl+shift+c=copy_to_clipboard

# Theme
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
background = #1a1b26
foreground = #c0caf5
cursor-color = #c0caf5
cursor-text = #1a1b26
selection-background = #283457
selection-foreground = #c0caf5
